FROM node:22-alpine

WORKDIR /app

# Копируем файлы зависимостей для эффективного кэширования слоев
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем остальные исходные файлы проекта
COPY . .

# Открываем порт сервера разработки Vite
EXPOSE 5173

# Запускаем dev-сервер с флагом --host для приема внешних соединений внутри Docker-сети
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]